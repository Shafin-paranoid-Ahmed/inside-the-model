---
interface Props { title?: string }
const { title } = Astro.props;
const id = title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<section data-step id={id}>
  {title && <h2 class="step-title"><a href={`#${id}`}>{title}</a></h2>}
  <slot />
</section>
<style>
  .step-title { font-size: var(--step-2); margin: 0 0 var(--s-3); }
  .step-title a { color: inherit; text-decoration: none; }
  section { scroll-margin-top: var(--s-6); }
</style>
