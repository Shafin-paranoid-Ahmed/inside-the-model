---
import { Font } from 'astro:assets';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE_NAME, absUrl, websiteLd } from '../lib/seo';
import ThemeToggle from '../components/ui/ThemeToggle.astro';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; jsonLd?: object; noindex?: boolean }
const { title, description = 'Learn how AI actually works in two weeks, by playing with interactive visualizations of the real mechanisms.' } = Astro.props;
const { type = 'website', noindex = false } = Astro.props;
const canonical = absUrl(Astro.url.pathname);
const ld = Astro.props.jsonLd ?? (canonical === absUrl('/') ? websiteLd() : undefined);
const ogImage = absUrl('/og.png');
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const nav = [
  { href: '/path', label: 'Path' },
  { href: '/refresher', label: 'Refresher' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Inside the Model: learn how AI actually works in two weeks, beside a small line drawing of a neural network." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') d.dataset.theme = t; } catch (e) {}
        if (/[?&]present\b/.test(location.search)) d.setAttribute('data-present', '');
      })();
    </script>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">Inside the Model</a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Inside the Model. Free, no login, nothing leaves your browser.</span>
      </div>
    </footer>
  </body>
</html>
<style>
  .site-header { border-bottom: 1px solid var(--rule); font-family: var(--font-ui); }
  .bar { max-width: 78rem; display: flex; align-items: center; justify-content: space-between; height: 3.5rem; gap: var(--s-4); }
  .brand { white-space: nowrap; font-weight: 700; letter-spacing: -0.02em; color: var(--text); text-decoration: none; font-size: 1.05rem; }
  nav { display: flex; align-items: center; gap: var(--s-1); font-size: var(--step--1); }
  nav a { color: var(--text-muted); text-decoration: none; padding: var(--s-2) var(--s-2); border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--text); }
  nav a[aria-current] { color: var(--text); border-bottom-color: var(--accent); }
  .site-footer { border-top: 1px solid var(--rule); margin-top: var(--s-8); padding-block: var(--s-5); font: var(--step--1) var(--font-ui); color: var(--text-muted); }
  @media (max-width: 30em) {
    nav a { padding-inline: 0.25rem; }
    nav { gap: 0; margin-left: auto; }
    .brand { font-size: 0.95rem; }
    .bar { gap: var(--s-2); flex-wrap: wrap; height: auto; min-height: 3.5rem; padding-block: var(--s-2); }
  }
</style>
