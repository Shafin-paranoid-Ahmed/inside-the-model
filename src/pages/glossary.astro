---
import Base from '../layouts/Base.astro';
import { GLOSSARY } from '../lib/glossary';
import { getCollection } from 'astro:content';

const titles = new Map((await getCollection('lessons')).map((l) => [l.id, l.data.title]));
const slug = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sorted = [...GLOSSARY].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const letterOf = (term: string) => {
  const c = term.normalize('NFKD')[0].toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
};
const groups = [...Map.groupBy(sorted, (t) => letterOf(t.term))];
---
<Base title="Glossary" description="Plain-language definitions of the terms used in the course, each linked to the lesson that teaches it.">
  <div class="wrap page">
    <h1>Glossary</h1>
    <p class="lede">{sorted.length} terms, each with a short definition and a link to the lesson that teaches it. Terms from lessons still being written are added as those lessons are finished.</p>
    <nav class="jump ui" aria-label="Jump to a letter">
      {groups.map(([letter]) => <a href={`#letter-${letter === '#' ? 'other' : letter.toLowerCase()}`}>{letter}</a>)}
    </nav>
    {groups.map(([letter, terms]) => (
      <section class="letter">
        <h2 id={`letter-${letter === '#' ? 'other' : letter.toLowerCase()}`}>{letter}</h2>
        <dl>
          {terms.map((t) => (
            <div class="entry" id={slug(t.term)}>
              <dt>{t.term}{t.aka && <span class="aka"> ({t.aka})</span>}</dt>
              <dd>
                <p>{t.def}</p>
                <a class="ui" href={`/learn/${t.lesson}`}>{titles.get(t.lesson) ?? t.lesson}</a>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-block: var(--s-7) 0; }
  h1 { font-size: var(--step-4); }
  .lede { max-width: var(--measure); color: var(--text-muted); margin-bottom: var(--s-5); }
  .jump { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); margin-bottom: var(--s-6); }
  .jump a { min-width: 1.6em; text-align: center; }
  .letter { padding-block: var(--s-4); border-top: 1px solid var(--rule); }
  h2 { font-size: var(--step-1); margin-bottom: var(--s-3); scroll-margin-top: var(--s-6); }
  dl { margin: 0; max-width: var(--measure); }
  .entry { padding-block: var(--s-3); scroll-margin-top: var(--s-6); }
  .entry:target { background: var(--accent-soft); border-radius: var(--r-1); padding-inline: var(--s-2); margin-inline: calc(-1 * var(--s-2)); }
  dt { font-weight: 600; }
  .aka { font-weight: 400; color: var(--text-muted); }
  dd { margin: var(--s-1) 0 0; }
  dd p { margin: 0 0 var(--s-1); }
  dd a { font-size: 0.85rem; }
</style>
