---
import Base from '../layouts/Base.astro';
---
<Base title="Glossary" description="Every term, linked to the lesson that teaches it.">
  <div class="wrap page">
    <h1>Glossary</h1>
    <div class="prose">
      <p>Every technical term will be listed here with a plain definition and a link to the lesson that teaches it.</p>
    </div>
  </div>
</Base>
<style>
  .page { padding-block: var(--s-7) 0; }
  h1 { font-size: var(--step-4); margin-bottom: var(--s-5); }
</style>
