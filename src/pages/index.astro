---
import Base from '../layouts/Base.astro';
import { getPath } from '../lib/curriculum';
import TrainingHero from '../components/widgets/TrainingHero/TrainingHero.svelte';
import LossLandscape3D from '../components/widgets/LossLandscape3D/LossLandscape3D.svelte';

const days = await getPath();
const lessons = days.flatMap((d) => d.lessons);
const start = lessons[0] ? `/learn/${lessons[0].id}` : '/path';
const FLAGSHIP = new Set([1, 5, 8, 9, 13]);
const weeks = [
  { n: 1, title: 'How learning works', days: days.filter((d) => d.day <= 7) },
  { n: 2, title: 'Modern AI', days: days.filter((d) => d.day > 7) },
];
---
<Base>
  <section class="hero">
    <div class="copy">
      <p class="kicker ui">An interactive course in {days.length} days</p>
      <h1>Learn how AI actually works in two weeks.</h1>
      <p class="pitch">
        Every idea here is a live mechanism you can touch. Watch gradients flow backward through a network, an RNN
        unroll through time, attention light up across a sentence. From “what is a model?” to the frontier of 2026.
      </p>
      <p class="cta"><a class="btn btn-primary" href={start}>Start Day 1</a> <a class="btn" href="/path">See the full path</a></p>
      <p class="stats ui"><span class="num">{lessons.length}</span> lessons <span aria-hidden="true">·</span> <span class="num">{days.length}</span> days <span aria-hidden="true">·</span> <span class="num">0</span> sign-ups <span aria-hidden="true">·</span> runs in your browser</p>
    </div>
    <div class="fig"><LossLandscape3D client:load /></div>
  </section>

  <section class="wrap band" aria-labelledby="learn-h" data-reveal>
    <header class="head">
      <h2 id="learn-h">Watch a network learn</h2>
      <p>
        A small network, training live in your browser. It starts knowing nothing; every few milliseconds it nudges
        its weights downhill on the loss, and the boundary bends to fit the data. Add points and it adapts.
      </p>
    </header>
    <TrainingHero client:visible />
  </section>

  <section class="wrap band" aria-labelledby="path-h">
    <header class="head" data-reveal>
      <h2 id="path-h">The {days.length} days</h2>
      <p>Two to three hours a day. Every lesson also stands on its own, so you can jump straight to the one you need.</p>
    </header>
    {weeks.map((w) => (
      <div class="week" data-reveal>
        <h3 class="ui"><span class="num">Week {w.n}</span> {w.title}</h3>
        <ol class="days" style={`--cols: ${w.days.length}`}>
          {w.days.map((d) => (
            <li>
              <a href={d.lessons[0] ? `/learn/${d.lessons[0].id}` : '/path'}>
                <span class="n num">{String(d.day).padStart(2, '0')}</span>
                <span class="t">{d.title}</span>
                <span class="c ui">
                  {d.lessons.length} lessons
                  {FLAGSHIP.has(d.day) && <span class="flag">flagship</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
    <p class="all ui" data-reveal><a href="/path">See every lesson on the path <span aria-hidden="true">→</span></a></p>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    max-width: 78rem; margin-inline: auto; padding: var(--s-6) var(--gutter) var(--s-7);
    display: grid; gap: var(--s-5); align-items: center;
  }
  .kicker { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.02em; color: var(--accent); margin: 0 0 var(--s-3); }
  h1 { font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4rem); max-width: 14ch; letter-spacing: -0.035em; line-height: 1.02; }
  .pitch { max-width: 34rem; font-size: var(--step-1); line-height: 1.55; margin: var(--s-5) 0; color: var(--text); }
  .cta { display: flex; gap: var(--s-3); flex-wrap: wrap; margin: 0; }
  .stats { margin: var(--s-5) 0 0; font-size: 0.8125rem; color: var(--text-muted); }
  .stats .num { color: var(--text); font-weight: 600; }
  @media (min-width: 60em) {
    .hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--s-6); padding-top: var(--s-7); min-height: min(88vh, 52rem); }  }

  /* entrance: h1 only moves (stays the LCP element), the rest fades in behind it */
  @media (prefers-reduced-motion: no-preference) {
    .copy > * { animation: rise 0.9s var(--ease) both; }
    .copy > h1 { animation-name: lift; animation-delay: 60ms; }
    .copy > .pitch { animation-delay: 160ms; }
    .copy > .cta { animation-delay: 260ms; }
    .copy > .stats { animation-delay: 360ms; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  @keyframes lift { from { transform: translateY(18px); } }

  /* ---- sections ---- */
  .band { padding-block: var(--s-7); border-top: 1px solid var(--rule); }
  .head { display: grid; gap: var(--s-2) var(--s-6); margin-bottom: var(--s-5); }
  .head h2 { font-size: var(--step-3); letter-spacing: -0.025em; }
  .head p { margin: 0; max-width: 36rem; color: var(--text-muted); }
  @media (min-width: 52em) { .head { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); align-items: end; } }

  /* ---- the days ---- */
  .week + .week { margin-top: var(--s-5); }
  h3 { font-size: 0.8125rem; font-weight: 600; color: var(--text-muted); margin-bottom: var(--s-2); }
  h3 .num { color: var(--text); margin-right: 0.4em; }
  .days { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .days a {
    position: relative; display: flex; flex-direction: column; gap: var(--s-2); height: 100%;
    padding: var(--s-4) var(--s-3) var(--s-3); background: var(--bg); color: var(--text); text-decoration: none;
    transition: background-color 0.25s var(--ease);
  }
  .days a::after {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease);
  }
  .days a:hover, .days a:focus-visible { background: var(--bg-raised); }
  .days a:hover::after, .days a:focus-visible::after { transform: scaleX(1); }
  .n { font-size: 1.75rem; line-height: 1; color: var(--accent); letter-spacing: -0.04em; transition: transform 0.35s var(--ease); }
  .days a:hover .n { transform: translateY(-2px); }
  .t { font: 600 clamp(0.75rem, 0.62rem + 0.3vw, 0.875rem) / 1.3 var(--font-ui); letter-spacing: -0.01em; overflow-wrap: break-word; }
  .c { display: flex; flex-direction: column; gap: 2px; margin-top: auto; font-size: 0.75rem; color: var(--text-muted); }
  .flag { color: var(--accent); font-weight: 600; }
  .flag::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-right: 0.35em; vertical-align: middle; border-radius: 50%; background: currentColor; }
  @media (min-width: 40em) { .days { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .days { grid-template-columns: repeat(var(--cols, 7), minmax(0, 1fr)); } }
  .all { margin: var(--s-5) 0 0; font-size: 0.875rem; }
  .all a { font-weight: 600; }

  /* scroll reveals: native scroll-driven animation, no JS; browsers without it just show content */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 35%; }
    }
  }
</style>
