---
import Base from '../layouts/Base.astro';
---
<Base title="Refresher" description="Every lesson's refresher card in one place.">
  <div class="wrap page">
    <h1>Refresher</h1>
    <div class="prose">
      <p>Every lesson opens with a short refresher: a summary, the key equations and what to know first. This page will collect them all, for readers who want the recap without the walkthrough.</p>
    </div>
  </div>
</Base>
<style>
  .page { padding-block: var(--s-7) 0; }
  h1 { font-size: var(--step-4); margin-bottom: var(--s-5); }
</style>
