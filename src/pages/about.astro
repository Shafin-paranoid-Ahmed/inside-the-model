---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About AI Learner.">
  <div class="wrap page">
    <h1>About</h1>
    <div class="prose">
      <p>AI Learner teaches how AI works through small models that run in your browser. It is free, needs no account, and stores nothing on a server.</p>
      <p>The site is a portfolio project. Author details and links will go here.</p>
    </div>
  </div>
</Base>
<style>
  .page { padding-block: var(--s-7) 0; }
  h1 { font-size: var(--step-4); margin-bottom: var(--s-5); }
</style>
