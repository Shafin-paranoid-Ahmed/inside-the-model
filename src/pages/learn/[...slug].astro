---
import { getCollection, render } from 'astro:content';
import Lesson from '../../layouts/Lesson.astro';
import { TRACKS, getOrderedLessons, getMathPrimer } from '../../lib/curriculum';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const path = await getOrderedLessons();
  const math = await getMathPrimer();
  return lessons.map((entry) => {
    const list = entry.data.track === 'math' ? math : path;
    const i = list.findIndex((l) => l.id === entry.id);
    const ref = (l?: (typeof list)[number]) => (l ? { id: l.id, title: l.data.title } : undefined);
    return { params: { slug: entry.id }, props: { entry, prev: ref(list[i - 1]), next: ref(list[i + 1]) } };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const trackTitle = TRACKS.find((t) => t.id === entry.data.track)?.title;
---
<Lesson id={entry.id} {...entry.data} {trackTitle} {prev} {next}>
  <Content />
</Lesson>
